# The dev/start scripts pin the web server to port 3100 (not Next's default
# 3000, which belongs to another project on the dev machine). Next decides the
# port before these files are loaded, so overriding it means the --port flag in
# apps/web/package.json or `PORT=... pnpm --filter @educrm/web dev`, not a line
# here. Nothing else depends on the number: the browser talks to the API through
# the same-origin /api/v1/* rewrite below, so there is no CORS allow-list or
# cookie domain to keep in sync.

# Origin of the Nest API, used by Next's /api/v1/* rewrite (server-side only).
API_ORIGIN=http://localhost:4000

# Tenant slug sent with every login until real tenant selection exists (step 0.3 B).
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo
