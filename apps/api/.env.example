# Server
NODE_ENV=development
PORT=4000

# PostgreSQL
# DATABASE_URL — used by the running API (app_user, through PgBouncer, transaction pool mode)
# DATABASE_MIGRATION_URL — used by `prisma migrate` (migrator, direct to Postgres, bypasses PgBouncer)
DATABASE_URL=postgres://app_user:app_user_dev_pw@localhost:6433/educrm?pgbouncer=true
DATABASE_MIGRATION_URL=postgres://migrator:migrator_dev_pw@localhost:5433/educrm

# Redis
REDIS_URL=redis://localhost:6380

# Logging
LOG_LEVEL=info
