generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

model Tenant {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  branches        Branch[]
  users           User[]
  sessions        Session[]
  roles           Role[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  userBranches    UserBranch[]
  classrooms      Classroom[]
  disciplines     Discipline[]
  levels          Level[]
  ageCategories   AgeCategory[]
  paymentMethods  PaymentMethod[]
  holidays        Holiday[]
  teacherProfiles TeacherProfile[]
  clients         Client[]
  clientPhones    ClientPhone[]
  contactPersons  ContactPerson[]
  students        Student[]
  importBatches   ImportBatch[]

  @@map("tenants")
}

model Branch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Tashkent")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only STORED GENERATED column, uz_search_key(name) — see Discipline.
  nameKey   String?  @map("name_key")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  userBranches UserBranch[]
  classrooms   Classroom[]
  holidays     Holiday[]
  students     Student[]

  @@unique([tenantId, code])
  /// Target of the composite (tenant_id, branch_id) foreign keys on
  /// classrooms and holidays: a reference that carries the tenant makes a
  /// cross-tenant row structurally impossible, not just policy-blocked.
  @@unique([tenantId, id])
  @@map("branches")
}

enum PermissionScope {
  own
  branch
  all
}

/// Global catalog, no tenant_id, no RLS — app_user has SELECT only (see migration).
model Permission {
  code        String @id
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model User {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fullName     String   @map("full_name")
  phone        String?
  email        String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  /// Read-only STORED GENERATED column, uz_search_key(full_name).
  fullNameKey  String?  @map("full_name_key")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  sessions       Session[]
  userRoles      UserRole[]
  userBranches   UserBranch[]
  teacherProfile TeacherProfile?
  /// Students this employee is the responsible owner of (TZ 5.1 students.owner_id).
  ownedStudents  Student[]       @relation("StudentOwner")

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@map("users")
}

/// One row per issued refresh token (rotation chain via family_id). Rows are
/// never deleted, only soft-revoked (revoked_at) — reuse of an already-
/// revoked token's hash is how reuse detection recognizes a replayed token.
model Session {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@index([tenantId, userId])
  @@map("sessions")
}

model Role {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  permissionCode String          @map("permission_code")
  scope          PermissionScope

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@unique([tenantId, roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@map("user_roles")
}

enum OutboxStatus {
  /// Waiting to be claimed; `next_retry_at` says when it is due.
  pending
  /// Claimed by a dispatcher and handed to the queue.
  dispatched
  /// A handler ran to completion.
  done
  /// Gave up after MAX_ATTEMPTS — needs a human (TZ M2 "dead-letter + alert").
  dead
}

/// Transactional outbox (TZ 7.3 pattern 1). Rows are written *inside* the
/// business transaction via OutboxService.publish(event, tx) and picked up
/// afterwards by the worker process (APP_ROLE=worker).
///
/// The partial index TZ 5.2 asks for — `(next_retry_at) WHERE status =
/// 'pending'` — is not expressible here and lives in the migration only.
model OutboxEvent {
  id             String       @id @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  nextRetryAt    DateTime     @default(now()) @map("next_retry_at")
  lastError      String?      @map("last_error")
  causationId    String?      @map("causation_id") @db.Uuid
  causationDepth Int          @default(0) @map("causation_depth")
  createdAt      DateTime     @default(now()) @map("created_at")
  dispatchedAt   DateTime?    @map("dispatched_at")
  processedAt    DateTime?    @map("processed_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("outbox_events")
}

/// Append-only audit trail, TZ M11.3 format. No tenant relation on purpose:
/// the table is RANGE-partitioned by month, and an FK from it would have to
/// be re-validated on every partition attach while buying nothing — the log
/// must survive and stay readable regardless of what happens to the rows it
/// refers to.
///
/// `occurred_at` is in the primary key because Postgres requires the
/// partition key in every unique constraint. Writes go through AuditService;
/// UPDATE and DELETE are impossible (trigger + REVOKE, see the migration).
model AuditLog {
  id         String   @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@id([id, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, actorId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

model UserBranch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, userId, branchId])
  @@map("user_branches")
}

// ---------------------------------------------------------------------------
// Organization and reference data (TZ M1.1–M1.4)
//
// Every one of these is archived, never deleted (TZ M1.1 "Filial
// o'chirilmaydi — is_active=false", M1.3 "Har bir ma'lumotnoma yozuvi
// o'chirilmaydi"): historical lessons, charges and payments point at them,
// and a deleted row would cut those links.
//
// Name uniqueness is per tenant on `uz_search_key(name)`, not on the raw
// string — see the migration. "Ingliz tili" and "ingliz  tili" are the same
// discipline, and so is one typed with an ASCII apostrophe (TZ 8.5).
// ---------------------------------------------------------------------------

/// TZ M1.2. Occupancy is derived from lessons (TZ M4.4), never stored here.
model Classroom {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  /// Seats. Used as a capacity warning on enrollment (TZ M4.2), not a hard cap.
  capacity  Int?
  equipment String?
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@index([tenantId, branchId])
  @@map("classrooms")
}

/// TZ M1.3 "fan".
model Discipline {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  levels             Level[]
  teacherDisciplines TeacherDiscipline[]

  @@unique([tenantId, id])
  @@map("disciplines")
}

/// TZ M1.3 "daraja". `disciplineId` is optional: UX P6 chains filial → fan →
/// daraja, so a level usually belongs to one discipline, but a centre that
/// grades everything A1..C2 shouldn't have to re-enter the ladder per
/// discipline — a null discipline means "applies to all" (docs/QUESTIONS.md).
model Level {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  disciplineId String?  @map("discipline_id") @db.Uuid
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey      String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  discipline    Discipline?    @relation(fields: [tenantId, disciplineId], references: [tenantId, id])
  teacherLevels TeacherLevel[]

  @@unique([tenantId, id])
  @@index([tenantId, disciplineId])
  @@map("levels")
}

/// TZ M1.3 "yosh toifasi". An open-ended top band has `maxAge = null`.
model AgeCategory {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  minAge    Int      @map("min_age")
  maxAge    Int?     @map("max_age")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("age_categories")
}

/// TZ M1.3 "to'lov usuli" — how money arrived (cash, card, transfer...).
/// Carries no amounts and no behaviour: a payment references it, and
/// archiving one must not break historical payments (TZ M1.3 KERAK).
model PaymentMethod {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("payment_methods")
}

/// TZ M1.3 "bayramlar". Lesson materialization skips these dates (T08 /
/// TZ M4.3). A null `branchId` means the whole organization is closed.
model Holiday {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  date      DateTime @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@index([tenantId, date])
  @@map("holidays")
}

/// TZ M1.4 "O'qituvchi profili". Separate from `users` because it exists
/// only for employees who teach, and because availability and salary
/// settings (R1) hang off it. R0 carries the teaching qualifications only.
model TeacherProfile {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  notes     String?
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  user        User                @relation(fields: [tenantId, userId], references: [tenantId, id])
  disciplines TeacherDiscipline[]
  levels      TeacherLevel[]

  /// One profile per employee; `tenantId` is in the key so the composite
  /// FK below has something to point at.
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@map("teacher_profiles")
}

model TeacherDiscipline {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  teacherProfileId String @map("teacher_profile_id") @db.Uuid
  disciplineId     String @map("discipline_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [tenantId, teacherProfileId], references: [tenantId, id])
  discipline     Discipline     @relation(fields: [tenantId, disciplineId], references: [tenantId, id])

  @@unique([tenantId, teacherProfileId, disciplineId])
  @@index([tenantId, disciplineId])
  @@map("teacher_disciplines")
}

model TeacherLevel {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  teacherProfileId String @map("teacher_profile_id") @db.Uuid
  levelId          String @map("level_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [tenantId, teacherProfileId], references: [tenantId, id])
  level          Level          @relation(fields: [tenantId, levelId], references: [tenantId, id])

  @@unique([tenantId, teacherProfileId, levelId])
  @@index([tenantId, levelId])
  @@map("teacher_levels")
}

// ---------------------------------------------------------------------------
// T06 — students (TZ M3)
//
// `households` (TZ 5.1, for multi-child billing) is deliberately not built
// here — nothing in the T06 roadmap line needs it and R0 has no billing yet
// (T10). `clients.household_id` is left off `Client` for the same reason;
// adding it later is additive. See docs/QUESTIONS.md.
//
// `contact_persons` points at `Student` directly rather than through the TZ
// 5.1 `client_id` + `contact_person_students` join table: BR-S1 ("bitta
// client — bitta student") means that join buys sharing a contact across
// multiple *unrelated* client records, which is not a requirement the
// roadmap line asks for and has no UI to drive it in R0. Documented in
// docs/QUESTIONS.md as a deliberate simplification, reversible later.
//
// BR-S4 (merge) is out of scope for T06 — no `merged_into_id` column, since
// an unused nullable FK is dead weight until the merge flow exists.
// ---------------------------------------------------------------------------

enum Gender {
  male
  female
}

/// TZ 5.1 "clients": the billing/identity record a student (or, later, a
/// lead) hangs off. Kept separate from `Student` because BR-S1 is a 1:1 in
/// R0, but the TZ model still treats "the person" and "their student card"
/// as different concerns — a future lead-to-student conversion (M2.5)
/// attaches a `Student` to an existing `Client` rather than creating a new
/// person.
model Client {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  fullName    String    @map("full_name")
  birthDate   DateTime? @map("birth_date") @db.Date
  gender      Gender?
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(full_name).
  fullNameKey String?   @map("full_name_key")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  phones  ClientPhone[]
  student Student?

  @@unique([tenantId, id])
  @@map("clients")
}

/// TZ 5.1 "client_phones". `tenantId` is denormalized onto the child row
/// (not in the TZ column list) because CLAUDE.md's RLS policy is `tenant_id
/// = current_setting(...)` verbatim on every tenant-scoped table — a policy
/// that joined through `clients` to find the tenant would not be the
/// standard pattern and would not be covered by the same test template.
model ClientPhone {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// Normalized +998XXXXXXXXX (TZ M3.2 SHART, libphonenumber) — see
  /// `normalizePhone` in auth/phone.util.ts, reused here.
  phoneE164 String   @map("phone_e164")
  isPrimary Boolean  @default(true) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id])

  @@index([tenantId, phoneE164])
  @@index([tenantId, clientId])
  @@map("client_phones")
}

/// TZ 5.1 "contact_persons" — a student's parent/guardian/other contact.
/// See the module comment above for why this points at `Student` rather
/// than `Client` + a join table.
model ContactPerson {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  studentId             String    @map("student_id") @db.Uuid
  fullName              String    @map("full_name")
  relation              String
  phoneE164             String?   @map("phone_e164")
  email                 String?
  isBillRecipient       Boolean   @default(false) @map("is_bill_recipient")
  receivesNotifications Boolean   @default(true) @map("receives_notifications")
  telegramChatId        String?   @map("telegram_chat_id")
  telegramBlockedAt     DateTime? @map("telegram_blocked_at")
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id])

  @@index([tenantId, studentId])
  @@map("contact_persons")
}

enum StudentStatus {
  active
  frozen
  finished
  no_enrollment
  archived
}

/// TZ 5.1 "students" / M3. BR-S3: status is computed from enrollments once
/// they exist (T07); until then every student is `no_enrollment` except
/// where manually `archived` (the one status BR-S3 allows to be set by
/// hand). `cachedBalance`/`churnScore` are carried as columns now (TZ 5.1
/// lists them on this table) but are not yet computed by anything — T10/T11
/// own that — so they stay at their defaults.
model Student {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  status          StudentStatus @default(no_enrollment)
  ownerId         String?       @map("owner_id") @db.Uuid
  cachedBalance   BigInt        @default(0) @map("cached_balance")
  churnScore      Int?          @map("churn_score") @db.SmallInt
  blacklisted     Boolean       @default(false)
  blacklistReason String?       @map("blacklist_reason")
  customData      Json?         @map("custom_data")
  archivedAt      DateTime?     @map("archived_at")
  /// Set when this row was created by `POST /students/import/confirm`;
  /// what `POST /students/import/:batchId/rollback` archives (TZ M11.1
  /// SHART). Not in the TZ 5.1 column list — added because rollback-by-
  /// batch has nothing else to key off.
  importBatchId   String?       @map("import_batch_id") @db.Uuid
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  client         Client          @relation(fields: [tenantId, clientId], references: [tenantId, id])
  branch         Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  owner          User?           @relation("StudentOwner", fields: [tenantId, ownerId], references: [tenantId, id])
  contactPersons ContactPerson[]
  importBatch    ImportBatch?    @relation(fields: [importBatchId], references: [id])

  @@unique([tenantId, clientId])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@map("students")
}

enum ImportEntityType {
  students
}

/// TZ M11.1: every import is batched so it can be rolled back as a unit —
/// `rollback` archives every row stamped with this batch's id (TZ SHART
/// "bekor qilish — import qilingan yozuvlarni arxivlash"). No persisted
/// column-mapping template (TZ describes it as part of the flow, not a
/// SHART/KERAK of its own) — deferred, see docs/QUESTIONS.md.
model ImportBatch {
  id            String           @id @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  entityType    ImportEntityType @map("entity_type")
  fileName      String           @map("file_name")
  totalRows     Int              @map("total_rows")
  importedCount Int              @map("imported_count")
  errorCount    Int              @map("error_count")
  createdBy     String?          @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  rolledBackAt  DateTime?        @map("rolled_back_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  students Student[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("import_batches")
}
