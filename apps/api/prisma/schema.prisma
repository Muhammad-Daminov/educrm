generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

model Tenant {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  branches        Branch[]
  users           User[]
  sessions        Session[]
  roles           Role[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  userBranches    UserBranch[]

  @@map("tenants")
}

model Branch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Tashkent")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  userBranches UserBranch[]

  @@unique([tenantId, code])
  @@map("branches")
}

enum PermissionScope {
  own
  branch
  all
}

/// Global catalog, no tenant_id, no RLS — app_user has SELECT only (see migration).
model Permission {
  code        String @id
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model User {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fullName     String   @map("full_name")
  phone        String?
  email        String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  sessions     Session[]
  userRoles    UserRole[]
  userBranches UserBranch[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@map("users")
}

/// One row per issued refresh token (rotation chain via family_id). Rows are
/// never deleted, only soft-revoked (revoked_at) — reuse of an already-
/// revoked token's hash is how reuse detection recognizes a replayed token.
model Session {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@index([tenantId, userId])
  @@map("sessions")
}

model Role {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  permissionCode String          @map("permission_code")
  scope          PermissionScope

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@unique([tenantId, roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@map("user_roles")
}

enum OutboxStatus {
  /// Waiting to be claimed; `next_retry_at` says when it is due.
  pending
  /// Claimed by a dispatcher and handed to the queue.
  dispatched
  /// A handler ran to completion.
  done
  /// Gave up after MAX_ATTEMPTS — needs a human (TZ M2 "dead-letter + alert").
  dead
}

/// Transactional outbox (TZ 7.3 pattern 1). Rows are written *inside* the
/// business transaction via OutboxService.publish(event, tx) and picked up
/// afterwards by the worker process (APP_ROLE=worker).
///
/// The partial index TZ 5.2 asks for — `(next_retry_at) WHERE status =
/// 'pending'` — is not expressible here and lives in the migration only.
model OutboxEvent {
  id             String       @id @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  nextRetryAt    DateTime     @default(now()) @map("next_retry_at")
  lastError      String?      @map("last_error")
  causationId    String?      @map("causation_id") @db.Uuid
  causationDepth Int          @default(0) @map("causation_depth")
  createdAt      DateTime     @default(now()) @map("created_at")
  dispatchedAt   DateTime?    @map("dispatched_at")
  processedAt    DateTime?    @map("processed_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("outbox_events")
}

/// Append-only audit trail, TZ M11.3 format. No tenant relation on purpose:
/// the table is RANGE-partitioned by month, and an FK from it would have to
/// be re-validated on every partition attach while buying nothing — the log
/// must survive and stay readable regardless of what happens to the rows it
/// refers to.
///
/// `occurred_at` is in the primary key because Postgres requires the
/// partition key in every unique constraint. Writes go through AuditService;
/// UPDATE and DELETE are impossible (trigger + REVOKE, see the migration).
model AuditLog {
  id         String   @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@id([id, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, actorId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

model UserBranch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, userId, branchId])
  @@map("user_branches")
}
