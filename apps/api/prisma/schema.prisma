generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

model Tenant {
  id        String   @id @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  branches        Branch[]
  users           User[]
  sessions        Session[]
  roles           Role[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  userBranches    UserBranch[]
  classrooms      Classroom[]
  disciplines     Discipline[]
  levels          Level[]
  ageCategories   AgeCategory[]
  paymentMethods  PaymentMethod[]
  holidays        Holiday[]
  teacherProfiles TeacherProfile[]
  clients         Client[]
  clientPhones    ClientPhone[]
  contactPersons  ContactPerson[]
  students        Student[]
  importBatches   ImportBatch[]
  studyUnits      StudyUnit[]
  enrollments     Enrollment[]
  scheduleRules   ScheduleRule[]
  lessons         Lesson[]

  @@map("tenants")
}

model Branch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Tashkent")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only STORED GENERATED column, uz_search_key(name) — see Discipline.
  nameKey   String?  @map("name_key")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  userBranches UserBranch[]
  classrooms   Classroom[]
  holidays     Holiday[]
  students     Student[]
  studyUnits   StudyUnit[]

  @@unique([tenantId, code])
  /// Target of the composite (tenant_id, branch_id) foreign keys on
  /// classrooms and holidays: a reference that carries the tenant makes a
  /// cross-tenant row structurally impossible, not just policy-blocked.
  @@unique([tenantId, id])
  @@map("branches")
}

enum PermissionScope {
  own
  branch
  all
}

/// Global catalog, no tenant_id, no RLS — app_user has SELECT only (see migration).
model Permission {
  code        String @id
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model User {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fullName     String   @map("full_name")
  phone        String?
  email        String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  /// Read-only STORED GENERATED column, uz_search_key(full_name).
  fullNameKey  String?  @map("full_name_key")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant                   Tenant          @relation(fields: [tenantId], references: [id])
  sessions                 Session[]
  userRoles                UserRole[]
  userBranches             UserBranch[]
  teacherProfile           TeacherProfile?
  /// Students this employee is the responsible owner of (TZ 5.1 students.owner_id).
  ownedStudents            Student[]       @relation("StudentOwner")
  /// study_units this employee is named `responsible_id` on (TZ M4.1).
  responsibleForStudyUnits StudyUnit[]     @relation("StudyUnitResponsible")
  /// T08 (TZ M4.3/M4.4). Three separate relations because a lesson names a
  /// teacher three ways: the one the rule assigned, the one who actually
  /// taught it (what conflicts and payroll key off), and whoever marked it
  /// complete.
  scheduleRules            ScheduleRule[]
  plannedLessons           Lesson[]        @relation("LessonTeacher")
  taughtLessons            Lesson[]        @relation("LessonActualTeacher")
  completedLessons         Lesson[]        @relation("LessonCompletedBy")

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@map("users")
}

/// One row per issued refresh token (rotation chain via family_id). Rows are
/// never deleted, only soft-revoked (revoked_at) — reuse of an already-
/// revoked token's hash is how reuse detection recognizes a replayed token.
model Session {
  id        String    @id @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@index([tenantId, userId])
  @@map("sessions")
}

model Role {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  id             String          @id @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  permissionCode String          @map("permission_code")
  scope          PermissionScope

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@unique([tenantId, roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId, roleId])
  @@map("user_roles")
}

enum OutboxStatus {
  /// Waiting to be claimed; `next_retry_at` says when it is due.
  pending
  /// Claimed by a dispatcher and handed to the queue.
  dispatched
  /// A handler ran to completion.
  done
  /// Gave up after MAX_ATTEMPTS — needs a human (TZ M2 "dead-letter + alert").
  dead
}

/// Transactional outbox (TZ 7.3 pattern 1). Rows are written *inside* the
/// business transaction via OutboxService.publish(event, tx) and picked up
/// afterwards by the worker process (APP_ROLE=worker).
///
/// The partial index TZ 5.2 asks for — `(next_retry_at) WHERE status =
/// 'pending'` — is not expressible here and lives in the migration only.
model OutboxEvent {
  id             String       @id @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  nextRetryAt    DateTime     @default(now()) @map("next_retry_at")
  lastError      String?      @map("last_error")
  causationId    String?      @map("causation_id") @db.Uuid
  causationDepth Int          @default(0) @map("causation_depth")
  createdAt      DateTime     @default(now()) @map("created_at")
  dispatchedAt   DateTime?    @map("dispatched_at")
  processedAt    DateTime?    @map("processed_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("outbox_events")
}

/// Append-only audit trail, TZ M11.3 format. No tenant relation on purpose:
/// the table is RANGE-partitioned by month, and an FK from it would have to
/// be re-validated on every partition attach while buying nothing — the log
/// must survive and stay readable regardless of what happens to the rows it
/// refers to.
///
/// `occurred_at` is in the primary key because Postgres requires the
/// partition key in every unique constraint. Writes go through AuditService;
/// UPDATE and DELETE are impossible (trigger + REVOKE, see the migration).
model AuditLog {
  id         String   @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@id([id, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, actorId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

model UserBranch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, userId, branchId])
  @@map("user_branches")
}

// ---------------------------------------------------------------------------
// Organization and reference data (TZ M1.1–M1.4)
//
// Every one of these is archived, never deleted (TZ M1.1 "Filial
// o'chirilmaydi — is_active=false", M1.3 "Har bir ma'lumotnoma yozuvi
// o'chirilmaydi"): historical lessons, charges and payments point at them,
// and a deleted row would cut those links.
//
// Name uniqueness is per tenant on `uz_search_key(name)`, not on the raw
// string — see the migration. "Ingliz tili" and "ingliz  tili" are the same
// discipline, and so is one typed with an ASCII apostrophe (TZ 8.5).
// ---------------------------------------------------------------------------

/// TZ M1.2. Occupancy is derived from lessons (TZ M4.4), never stored here.
model Classroom {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  /// Seats. Used as a capacity warning on enrollment (TZ M4.2), not a hard cap.
  capacity  Int?
  equipment String?
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  branch        Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id])
  scheduleRules ScheduleRule[]
  lessons       Lesson[]

  /// The composite FK `lessons`/`schedule_rules` point at.
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("classrooms")
}

/// TZ M1.3 "fan".
model Discipline {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  levels             Level[]
  teacherDisciplines TeacherDiscipline[]
  studyUnits         StudyUnit[]

  @@unique([tenantId, id])
  @@map("disciplines")
}

/// TZ M1.3 "daraja". `disciplineId` is optional: UX P6 chains filial → fan →
/// daraja, so a level usually belongs to one discipline, but a centre that
/// grades everything A1..C2 shouldn't have to re-enter the ladder per
/// discipline — a null discipline means "applies to all" (docs/QUESTIONS.md).
model Level {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  disciplineId String?  @map("discipline_id") @db.Uuid
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey      String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  discipline    Discipline?    @relation(fields: [tenantId, disciplineId], references: [tenantId, id])
  teacherLevels TeacherLevel[]
  studyUnits    StudyUnit[]

  @@unique([tenantId, id])
  @@index([tenantId, disciplineId])
  @@map("levels")
}

/// TZ M1.3 "yosh toifasi". An open-ended top band has `maxAge = null`.
model AgeCategory {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  minAge    Int      @map("min_age")
  maxAge    Int?     @map("max_age")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  /// FK'd by plain `id` (not the composite (tenant_id,id) pattern) like
  /// `Student.importBatch` — this table has no (tenantId, id) unique index.
  studyUnits StudyUnit[]

  @@map("age_categories")
}

/// TZ M1.3 "to'lov usuli" — how money arrived (cash, card, transfer...).
/// Carries no amounts and no behaviour: a payment references it, and
/// archiving one must not break historical payments (TZ M1.3 KERAK).
model PaymentMethod {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("payment_methods")
}

/// TZ M1.3 "bayramlar". Lesson materialization skips these dates (T08 /
/// TZ M4.3). A null `branchId` means the whole organization is closed.
model Holiday {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String
  date      DateTime @db.Date
  isActive  Boolean  @default(true) @map("is_active")
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name).
  /// Never pass it in create/update data — the database computes it. List
  /// endpoints filter and ORDER BY it, so names sort the TZ 8.5 way
  /// instead of by code point.
  nameKey   String?  @map("name_key")
  /// Optimistic locking (TZ 6.1): bumped inside the same UPDATE that
  /// filters on it, so a lost update is impossible rather than unlikely.
  /// A mismatch is 409 VERSION_CONFLICT.
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@index([tenantId, date])
  @@map("holidays")
}

/// TZ M1.4 "O'qituvchi profili". Separate from `users` because it exists
/// only for employees who teach, and because availability and salary
/// settings (R1) hang off it. R0 carries the teaching qualifications only.
model TeacherProfile {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  notes     String?
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  user        User                @relation(fields: [tenantId, userId], references: [tenantId, id])
  disciplines TeacherDiscipline[]
  levels      TeacherLevel[]

  /// One profile per employee; `tenantId` is in the key so the composite
  /// FK below has something to point at.
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@map("teacher_profiles")
}

model TeacherDiscipline {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  teacherProfileId String @map("teacher_profile_id") @db.Uuid
  disciplineId     String @map("discipline_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [tenantId, teacherProfileId], references: [tenantId, id])
  discipline     Discipline     @relation(fields: [tenantId, disciplineId], references: [tenantId, id])

  @@unique([tenantId, teacherProfileId, disciplineId])
  @@index([tenantId, disciplineId])
  @@map("teacher_disciplines")
}

model TeacherLevel {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  teacherProfileId String @map("teacher_profile_id") @db.Uuid
  levelId          String @map("level_id") @db.Uuid

  teacherProfile TeacherProfile @relation(fields: [tenantId, teacherProfileId], references: [tenantId, id])
  level          Level          @relation(fields: [tenantId, levelId], references: [tenantId, id])

  @@unique([tenantId, teacherProfileId, levelId])
  @@index([tenantId, levelId])
  @@map("teacher_levels")
}

// ---------------------------------------------------------------------------
// T06 — students (TZ M3)
//
// `households` (TZ 5.1, for multi-child billing) is deliberately not built
// here — nothing in the T06 roadmap line needs it and R0 has no billing yet
// (T10). `clients.household_id` is left off `Client` for the same reason;
// adding it later is additive. See docs/QUESTIONS.md.
//
// `contact_persons` points at `Student` directly rather than through the TZ
// 5.1 `client_id` + `contact_person_students` join table: BR-S1 ("bitta
// client — bitta student") means that join buys sharing a contact across
// multiple *unrelated* client records, which is not a requirement the
// roadmap line asks for and has no UI to drive it in R0. Documented in
// docs/QUESTIONS.md as a deliberate simplification, reversible later.
//
// BR-S4 (merge) is out of scope for T06 — no `merged_into_id` column, since
// an unused nullable FK is dead weight until the merge flow exists.
// ---------------------------------------------------------------------------

enum Gender {
  male
  female
}

/// TZ 5.1 "clients": the billing/identity record a student (or, later, a
/// lead) hangs off. Kept separate from `Student` because BR-S1 is a 1:1 in
/// R0, but the TZ model still treats "the person" and "their student card"
/// as different concerns — a future lead-to-student conversion (M2.5)
/// attaches a `Student` to an existing `Client` rather than creating a new
/// person.
model Client {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  fullName    String    @map("full_name")
  birthDate   DateTime? @map("birth_date") @db.Date
  gender      Gender?
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(full_name).
  fullNameKey String?   @map("full_name_key")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  phones  ClientPhone[]
  student Student?

  @@unique([tenantId, id])
  @@map("clients")
}

/// TZ 5.1 "client_phones". `tenantId` is denormalized onto the child row
/// (not in the TZ column list) because CLAUDE.md's RLS policy is `tenant_id
/// = current_setting(...)` verbatim on every tenant-scoped table — a policy
/// that joined through `clients` to find the tenant would not be the
/// standard pattern and would not be covered by the same test template.
model ClientPhone {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  /// Normalized +998XXXXXXXXX (TZ M3.2 SHART, libphonenumber) — see
  /// `normalizePhone` in auth/phone.util.ts, reused here.
  phoneE164 String   @map("phone_e164")
  isPrimary Boolean  @default(true) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  client Client @relation(fields: [tenantId, clientId], references: [tenantId, id])

  @@index([tenantId, phoneE164])
  @@index([tenantId, clientId])
  @@map("client_phones")
}

/// TZ 5.1 "contact_persons" — a student's parent/guardian/other contact.
/// See the module comment above for why this points at `Student` rather
/// than `Client` + a join table.
model ContactPerson {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  studentId             String    @map("student_id") @db.Uuid
  fullName              String    @map("full_name")
  relation              String
  phoneE164             String?   @map("phone_e164")
  email                 String?
  isBillRecipient       Boolean   @default(false) @map("is_bill_recipient")
  receivesNotifications Boolean   @default(true) @map("receives_notifications")
  telegramChatId        String?   @map("telegram_chat_id")
  telegramBlockedAt     DateTime? @map("telegram_blocked_at")
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id])

  @@index([tenantId, studentId])
  @@map("contact_persons")
}

enum StudentStatus {
  active
  frozen
  finished
  no_enrollment
  archived
}

/// TZ 5.1 "students" / M3. BR-S3: status is computed from enrollments once
/// they exist (T07); until then every student is `no_enrollment` except
/// where manually `archived` (the one status BR-S3 allows to be set by
/// hand). `cachedBalance`/`churnScore` are carried as columns now (TZ 5.1
/// lists them on this table) but are not yet computed by anything — T10/T11
/// own that — so they stay at their defaults.
model Student {
  id              String        @id @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  status          StudentStatus @default(no_enrollment)
  ownerId         String?       @map("owner_id") @db.Uuid
  cachedBalance   BigInt        @default(0) @map("cached_balance")
  churnScore      Int?          @map("churn_score") @db.SmallInt
  blacklisted     Boolean       @default(false)
  blacklistReason String?       @map("blacklist_reason")
  customData      Json?         @map("custom_data")
  archivedAt      DateTime?     @map("archived_at")
  /// Set when this row was created by `POST /students/import/confirm`;
  /// what `POST /students/import/:batchId/rollback` archives (TZ M11.1
  /// SHART). Not in the TZ 5.1 column list — added because rollback-by-
  /// batch has nothing else to key off.
  importBatchId   String?       @map("import_batch_id") @db.Uuid
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  client         Client          @relation(fields: [tenantId, clientId], references: [tenantId, id])
  branch         Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  owner          User?           @relation("StudentOwner", fields: [tenantId, ownerId], references: [tenantId, id])
  contactPersons ContactPerson[]
  importBatch    ImportBatch?    @relation(fields: [importBatchId], references: [id])
  /// TZ M4.2 / BR-S3 — this student's enrollment history, read to compute
  /// `status` above. See the T07 module comment near `StudyUnit`.
  enrollments    Enrollment[]

  @@unique([tenantId, clientId])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@map("students")
}

enum ImportEntityType {
  students
}

/// TZ M11.1: every import is batched so it can be rolled back as a unit —
/// `rollback` archives every row stamped with this batch's id (TZ SHART
/// "bekor qilish — import qilingan yozuvlarni arxivlash"). No persisted
/// column-mapping template (TZ describes it as part of the flow, not a
/// SHART/KERAK of its own) — deferred, see docs/QUESTIONS.md.
model ImportBatch {
  id            String           @id @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  entityType    ImportEntityType @map("entity_type")
  fileName      String           @map("file_name")
  totalRows     Int              @map("total_rows")
  importedCount Int              @map("imported_count")
  errorCount    Int              @map("error_count")
  createdBy     String?          @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  rolledBackAt  DateTime?        @map("rolled_back_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  students Student[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// T07 — study_units + enrollments (TZ M4.1 / M4.2)
//
// `defaultPriceId`/`priceId` and `curriculumId` from the TZ 5.1 column lists
// are omitted entirely for R0 — prices/discounts are T10, and nothing in R0
// reads a curriculum. `contractId`/`payerClientId`/`discountIds` on
// Enrollment are the same cut (contracts, discounts: T10/T11). See
// docs/QUESTIONS.md.
//
// `schedule_rules`/`lessons` (T08) do not exist yet, so BR-U1/BR-U2 ("no
// lessons while forming", "forming→active requires a schedule rule") are
// deliberately not enforced here — documented as a known gap in
// docs/QUESTIONS.md rather than invented around.
// ---------------------------------------------------------------------------

enum StudyUnitType {
  group
  mini_group
  individual
}

enum StudyUnitStatus {
  forming
  active
  paused
  finished
  cancelled
}

/// TZ M4.1 "study_unit" — a guruh/mini-guruh/individual teaching unit.
/// `capacity`/`minSize` drive BR-U3/BR-U4 warnings, never a hard block.
model StudyUnit {
  id            String          @id @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  branchId      String          @map("branch_id") @db.Uuid
  disciplineId  String          @map("discipline_id") @db.Uuid
  levelId       String?         @map("level_id") @db.Uuid
  ageCategoryId String?         @map("age_category_id") @db.Uuid
  type          StudyUnitType
  status        StudyUnitStatus @default(forming)
  name          String
  /// Read-only: a Postgres STORED GENERATED column, uz_search_key(name) —
  /// see Discipline for the pattern. Covers auto-generated names too, since
  /// those are written to `name` at create time (not a separate column).
  nameKey       String?         @map("name_key")
  capacity      Int
  minSize       Int             @map("min_size")
  responsibleId String?         @map("responsible_id") @db.Uuid
  color         String?
  startDate     DateTime?       @map("start_date") @db.Date
  endDate       DateTime?       @map("end_date") @db.Date
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  branch        Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id])
  discipline    Discipline     @relation(fields: [tenantId, disciplineId], references: [tenantId, id])
  level         Level?         @relation(fields: [tenantId, levelId], references: [tenantId, id])
  /// Plain `id` FK (not the composite pattern) — `age_categories` has no
  /// (tenant_id, id) unique index, same carve-out as `Student.importBatch`.
  ageCategory   AgeCategory?   @relation(fields: [ageCategoryId], references: [id])
  responsible   User?          @relation("StudyUnitResponsible", fields: [tenantId, responsibleId], references: [tenantId, id])
  enrollments   Enrollment[]
  scheduleRules ScheduleRule[]
  lessons       Lesson[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
  @@index([tenantId, nameKey])
  @@map("study_units")
}

enum EnrollmentStatus {
  active
  frozen
  finished
  transferred
  cancelled
}

/// TZ M4.2 "enrollment". BR-E1 (one student can't hold two overlapping
/// enrollments in the same study_unit) is a Postgres EXCLUDE constraint,
/// not application code — see the migration SQL. BR-E3: never hard-deleted
/// via the API, only cancelled (docs/QUESTIONS.md).
model Enrollment {
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  studyUnitId String           @map("study_unit_id") @db.Uuid
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime?        @map("end_date") @db.Date
  status      EnrollmentStatus @default(active)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  student   Student   @relation(fields: [tenantId, studentId], references: [tenantId, id])
  studyUnit StudyUnit @relation(fields: [tenantId, studyUnitId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, studyUnitId, status])
  @@index([tenantId, studentId, status])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// T08 — schedule (TZ M4.3–M4.7)
//
// Lessons are *materialized* rather than computed from a recurrence rule on
// every read. TZ M4.3 marks this SHART and gives the reasons: conflict
// control lives in a DB constraint (which needs rows to constrain), each
// lesson is individually editable, attendance and charges attach to a
// lesson, and recomputing an RRULE per request is slow.
// ---------------------------------------------------------------------------

/// TZ M4.3 "schedule_rule" — the recurrence that lessons are generated from.
///
/// Two modes, enforced by CHECK constraints in the migration rather than in
/// the DTO alone:
///   * duration — either `endTime` (a fixed clock slot) or
///     `academicHoursPerDay` (+ `breakMinutes`), exactly one of the two;
///   * extent — `periodEnd` (a date) or `totalAcademicHours` (a budget), at
///     least one of the two, so generation always has somewhere to stop.
model ScheduleRule {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  studyUnitId         String    @map("study_unit_id") @db.Uuid
  /// ISO-8601 weekday numbers: 1 = Monday ... 7 = Sunday.
  daysOfWeek          Int[]     @map("days_of_week") @db.SmallInt
  /// `HH:MM` local wall-clock time in the branch's timezone. TEXT, not
  /// Postgres `time` — see the migration header for why (Prisma has no
  /// time-only scalar). CHECK-constrained to a real 24-hour clock time.
  startTime           String    @map("start_time")
  endTime             String?   @map("end_time")
  /// TZ M4.3's alternative to `endTime`: an academic-hour count per day,
  /// which with `breakMinutes` gives the lesson's wall-clock length.
  academicHoursPerDay Decimal?  @map("academic_hours_per_day") @db.Decimal(5, 2)
  breakMinutes        Int       @default(0) @map("break_minutes")
  periodStart         DateTime  @map("period_start") @db.Date
  periodEnd           DateTime? @map("period_end") @db.Date
  /// Total-hours mode: generate until this budget is spent. TZ M4.3 —
  /// holidays don't consume budget, they push the period's end out.
  totalAcademicHours  Decimal?  @map("total_academic_hours") @db.Decimal(7, 2)
  classroomId         String?   @map("classroom_id") @db.Uuid
  teacherId           String?   @map("teacher_id") @db.Uuid
  /// Deactivated, never deleted: lessons point here, and TZ M4.3 requires
  /// past lessons to survive a rule change untouched.
  isActive            Boolean   @default(true) @map("is_active")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  studyUnit StudyUnit  @relation(fields: [tenantId, studyUnitId], references: [tenantId, id])
  classroom Classroom? @relation(fields: [tenantId, classroomId], references: [tenantId, id])
  teacher   User?      @relation(fields: [tenantId, teacherId], references: [tenantId, id])
  lessons   Lesson[]

  @@unique([tenantId, id])
  @@index([tenantId, studyUnitId])
  @@map("schedule_rules")
}

enum LessonStatus {
  planned
  completed
  cancelled
  moved
}

/// TZ M4.3–M4.7 "lesson". One materialized occurrence.
///
/// The two conflict constraints (TZ M4.4, kritik) are
/// `EXCLUDE USING gist` in the migration, not application checks: a
/// `SELECT ... overlaps` then `INSERT` races, and the database is the only
/// place the guarantee can actually hold. The service turns the violation
/// into a `SCHEDULE_CONFLICT` body carrying free alternatives (UX P4).
model Lesson {
  id                String       @id @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  studyUnitId       String       @map("study_unit_id") @db.Uuid
  /// Null for an extra/makeup lesson created by hand. Never nulled by a
  /// rule deletion: rules are deactivated, never deleted, and the FK is
  /// RESTRICT (a composite `ON DELETE SET NULL` would try to null the
  /// required `tenant_id` too).
  scheduleRuleId    String?      @map("schedule_rule_id") @db.Uuid
  /// The local calendar date, kept alongside `startAt` because "which
  /// day is this lesson on" is a branch-local question that a timestamptz
  /// alone cannot answer without re-deriving the branch timezone.
  date              DateTime     @db.Date
  startAt           DateTime     @map("start_at") @db.Timestamptz(3)
  endAt             DateTime     @map("end_at") @db.Timestamptz(3)
  classroomId       String?      @map("classroom_id") @db.Uuid
  teacherId         String?      @map("teacher_id") @db.Uuid
  /// TZ M4.4 (TUZATILDI): conflicts and payroll key off the teacher who
  /// actually taught, defaulting to `teacherId`. Substituting changes only
  /// this, so the substitute's own calendar is protected too.
  actualTeacherId   String?      @map("actual_teacher_id") @db.Uuid
  status            LessonStatus @default(planned)
  /// TZ M4.3 (SHART): a hand-edited lesson is never overwritten by
  /// regeneration.
  isDetached        Boolean      @default(false) @map("is_detached")
  academicHours     Decimal?     @map("academic_hours") @db.Decimal(5, 2)
  /// Free text. TZ 5.1's `topic_id` (-> curriculum_topics) is omitted —
  /// nothing in R0 reads a curriculum, same carve-out as
  /// `StudyUnit.curriculumId`.
  topic             String?
  homework          String?
  notes             String?
  makeupForLessonId String?      @map("makeup_for_lesson_id") @db.Uuid
  movedToLessonId   String?      @map("moved_to_lesson_id") @db.Uuid
  cancelReason      String?      @map("cancel_reason")
  completedAt       DateTime?    @map("completed_at")
  completedBy       String?      @map("completed_by") @db.Uuid
  /// TZ M4.3 (SHART) "a lesson with attendance is never auto-deleted".
  /// `attendances` is T09, so this counter is the forward-compatible seam
  /// regeneration and the DELETE-guard trigger check today; T09 maintains
  /// it in the same transaction as every attendance write. See
  /// docs/QUESTIONS.md.
  attendanceCount   Int          @default(0) @map("attendance_count")
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  studyUnit       StudyUnit     @relation(fields: [tenantId, studyUnitId], references: [tenantId, id])
  scheduleRule    ScheduleRule? @relation(fields: [tenantId, scheduleRuleId], references: [tenantId, id])
  classroom       Classroom?    @relation(fields: [tenantId, classroomId], references: [tenantId, id])
  teacher         User?         @relation("LessonTeacher", fields: [tenantId, teacherId], references: [tenantId, id])
  actualTeacher   User?         @relation("LessonActualTeacher", fields: [tenantId, actualTeacherId], references: [tenantId, id])
  completedByUser User?         @relation("LessonCompletedBy", fields: [tenantId, completedBy], references: [tenantId, id])

  makeupFor Lesson?  @relation("LessonMakeup", fields: [tenantId, makeupForLessonId], references: [tenantId, id])
  makeups   Lesson[] @relation("LessonMakeup")
  movedTo   Lesson?  @relation("LessonMoved", fields: [tenantId, movedToLessonId], references: [tenantId, id])
  movedFrom Lesson[] @relation("LessonMoved")

  @@unique([tenantId, id])
  @@index([tenantId, studyUnitId, startAt])
  @@index([tenantId, actualTeacherId, startAt])
  @@index([tenantId, classroomId, startAt])
  @@index([tenantId, scheduleRuleId, date])
  @@map("lessons")
}
